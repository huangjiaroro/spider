<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hexin.cbas.spider.dal.mapper.spider.PassAlertInstanceMapper">


    <select id="selectAll"  resultType="java.lang.String">
        select paas_alert_instance
        from spider_paas_alert_instance
    </select>




    <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
        delete from spider_paas_alert_instance
        where paas_alert_instance =#{paasAlertInstance}
    </delete>


    <insert id="insert" parameterType="java.lang.String">
    insert into spider_paas_alert_instance (paas_alert_instance)
    values (#{paasAlertInstance} )
  </insert>


</mapper>